//@version=6
indicator("EMA Pullback Continuation Bullish + Bearish with RSI + 1H Confirmation", overlay=true)

// ======================================================
// EMA SETTINGS
// ======================================================

ema9  = ta.ema(close, 9)
ema21 = ta.ema(close, 21)

plot(ema9, color=color.green, linewidth=2, title="EMA 9")
plot(ema21, color=color.red, linewidth=2, title="EMA 21")

// ======================================================
// HIGHER TIMEFRAME (1 HOUR) CONFIRMATION
// ======================================================

htfBullish = request.security(
     syminfo.tickerid,
     "60",
     close[1] > open[1],
     lookahead = barmerge.lookahead_off
)

htfBearish = request.security(
     syminfo.tickerid,
     "60",
     close[1] < open[1],
     lookahead = barmerge.lookahead_off
)

// ======================================================
// RSI
// ======================================================

rsiValue = ta.rsi(close, 14)

plot(
     rsiValue,
     title="RSI",
     color=color.blue,
     display=display.data_window
)

// ======================================================
// COMMON CANDLE STRUCTURE
// ======================================================

bodySize  = math.abs(close - open)
rangeSize = high - low

upperWick = high - math.max(open, close)
lowerWick = math.min(open, close) - low

// ======================================================
// STATE VARIABLES
// ======================================================

// Bullish states
var bullTrendActive = false
var bullMoveAwayDone = false
var bullPullbackDone = false

// Bearish states
var bearTrendActive = false
var bearMoveAwayDone = false
var bearPullbackDone = false

// ======================================================
// CROSSOVERS
// ======================================================

bullCross = ta.crossover(ema9, ema21)
bearCross = ta.crossunder(ema9, ema21)

// ======================================================
// BULLISH TREND LOGIC
// ======================================================

// Activate bullish trend
if bullCross
    bullTrendActive := true
    bullMoveAwayDone := false
    bullPullbackDone := false

    // Reset bearish state
    bearTrendActive := false
    bearMoveAwayDone := false
    bearPullbackDone := false

// Invalidate bullish trend
if ema9 <= ema21
    bullTrendActive := false
    bullMoveAwayDone := false
    bullPullbackDone := false

// ======================================================
// STEP 1:
// PRICE MUST MOVE AWAY FROM 21 EMA
// ======================================================

bullMoveAway =
     bullTrendActive and
     close > ema9 and
     close > ema21

if bullMoveAway
    bullMoveAwayDone := true

// ======================================================
// STEP 2:
// VALID RETEST OF 21 EMA
// ======================================================

// Retest candle must actually touch 21 EMA
validBullRetest =
     bullMoveAwayDone and
     low <= ema21 and
     close > ema21

// Pullback valid ONLY on retest candle
if validBullRetest
    bullPullbackDone := true
else
    bullPullbackDone := false

// ======================================================
// BULLISH CONFIRMATION CANDLE
// ======================================================

bullishCandle =
     close > open

bullStrongClose =
     close > ema9

bullMomentumCandle =
     bodySize > rangeSize * 0.6 and
     upperWick < bodySize * 0.15

hammerCandle =
     lowerWick > bodySize * 1.5 and
     upperWick < bodySize * 0.25

// Signal ONLY after retest candle
bullEntrySignal =
     bullTrendActive and
     bullPullbackDone[1] and
     bullishCandle and
     bullStrongClose and
     htfBullish and
     (bullMomentumCandle or hammerCandle)

// Reset after bullish signal
if bullEntrySignal
    bullMoveAwayDone := false
    bullPullbackDone := false

// ======================================================
// BEARISH TREND LOGIC
// ======================================================

// Activate bearish trend
if bearCross
    bearTrendActive := true
    bearMoveAwayDone := false
    bearPullbackDone := false

    // Reset bullish state
    bullTrendActive := false
    bullMoveAwayDone := false
    bullPullbackDone := false

// Invalidate bearish trend
if ema9 >= ema21
    bearTrendActive := false
    bearMoveAwayDone := false
    bearPullbackDone := false

// ======================================================
// STEP 1:
// PRICE MUST MOVE AWAY FROM 21 EMA
// ======================================================

bearMoveAway =
     bearTrendActive and
     close < ema9 and
     close < ema21

if bearMoveAway
    bearMoveAwayDone := true

// ======================================================
// STEP 2:
// VALID RETEST OF 21 EMA
// ======================================================

// Candle must properly retest EMA21
validBearRetest =
     bearMoveAwayDone and
     high >= ema21 and
     close < ema21

// Pullback valid ONLY on retest candle
if validBearRetest
    bearPullbackDone := true
else
    bearPullbackDone := false

// ======================================================
// BEARISH CONFIRMATION CANDLE
// ======================================================

bearishCandle =
     close < open

bearStrongClose =
     close < ema9

bearMomentumCandle =
     bodySize > rangeSize * 0.6 and
     lowerWick < bodySize * 0.15

shootingStarCandle =
     upperWick > bodySize * 1.5 and
     lowerWick < bodySize * 0.25

// Signal ONLY after retest candle
bearEntrySignal =
     bearTrendActive and
     bearPullbackDone[1] and
     bearishCandle and
     bearStrongClose and
     htfBearish and
     (bearMomentumCandle or shootingStarCandle)

// Reset after bearish signal
if bearEntrySignal
    bearMoveAwayDone := false
    bearPullbackDone := false

// ======================================================
// SIGNAL PLOTS
// ======================================================

plotshape(
     bullEntrySignal,
     title="BUY",
     location=location.belowbar,
     style=shape.triangleup,
     color=color.lime,
     size=size.small,
     text="BUY"
)

plotshape(
     bearEntrySignal,
     title="SELL",
     location=location.abovebar,
     style=shape.triangledown,
     color=color.red,
     size=size.small,
     text="SELL"
)

// ======================================================
// BAR COLORS
// ======================================================

barcolor(
     bullEntrySignal
     ? color.lime
     : bearEntrySignal
     ? color.red
     : na
)

// ======================================================
// ALERTS
// ======================================================

alertcondition(
     bullEntrySignal,
     title="Bullish Entry Alert",
     message="Bullish EMA Pullback Continuation Signal"
)

alertcondition(
     bearEntrySignal,
     title="Bearish Entry Alert",
     message="Bearish EMA Pullback Continuation Signal"
)
